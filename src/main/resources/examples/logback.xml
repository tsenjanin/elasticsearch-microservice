<?xml version="1.0" encoding="UTF-8"?>
<!--
	Example only: shows the ECS JSON format and file rolling (whatever.log + whatever-yyyy-MM-dd.i.log.gz) that this
	service expects from the remote log servers. It is outside the classpath root, so neither Spring Boot nor logback
	loads it; the app itself uses Spring Boot's default console logging. To try it on a host run, start the app with
	logging.config=classpath:examples/logback.xml (it writes into src/main/resources/logs, so not in the container).
-->
<configuration scan="true" scanPeriod="30 seconds">

	<contextName>todo</contextName>
	<property name="ROOT_DIR" value="src/main/resources/logs" />
	<property name="MAIN_LOG" value="elasticsearch" />

	<property name="PATTERN_DEFAULT"
		value="{&quot;@timestamp&quot;:&quot;%d{&quot;yyyy-MM-dd'T'HH:mm:ss.SSSXXX&quot;}&quot;,&quot;log&quot;:{&quot;level&quot;:&quot;%level&quot;,&quot;logger&quot;:&quot;%logger&quot;},&quot;process&quot;:{&quot;thread&quot;:{&quot;name&quot;:&quot;%thread&quot;}},&quot;service&quot;:{&quot;name&quot;:&quot;%contextName&quot;},&quot;sid&quot;:&quot;%X{sid}&quot;,&quot;uid&quot;:&quot;%X{uid}&quot;,&quot;message&quot;:&quot;%replace(%replace(%replace(%replace(%message){'\\','\\\\'}){'&quot;','\\&quot;'}){'\t','\\t'}){'\r?\n','\\n'}&quot;,&quot;error&quot;:{&quot;stack_trace&quot;:&quot;%replace(%replace(%replace(%replace(%exception){'\\','\\\\'}){'&quot;','\\&quot;'}){'\t','\\t'}){'\r?\n','\\n'}&quot;},&quot;ecs&quot;:{&quot;version&quot;:&quot;8.11&quot;}}%nopex%n" />

	<appender name="MAIN_APPENDER" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<append>true</append>
		<file>${ROOT_DIR}/${MAIN_LOG}.log</file>
		<encoder>
			<pattern>${PATTERN_DEFAULT}</pattern>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${ROOT_DIR}/${MAIN_LOG}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
			<timeBasedFileNamingAndTriggeringPolicy
				class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<maxFileSize>10MB</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>
		</rollingPolicy>
	</appender>

	<logger name="todo" level="DEBUG" additivity="false">
		<appender-ref ref="MAIN_APPENDER" />
	</logger>

	<root level="ERROR">
		<appender-ref ref="MAIN_APPENDER" />
	</root>

</configuration>
